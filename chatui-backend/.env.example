# Copy this file to ".env" in this same folder (chatui-backend/.env) and
# adjust the values for your setup. The backend loads this file
# automatically on startup (via python-dotenv). NEVER commit a real .env.

# ---------------------------------------------------------------------------
# Local llama.cpp
# ---------------------------------------------------------------------------
# Full path to llama-server.exe
LLAMA_CPP_EXE=C:\llama.cpp\llama-server.exe
# Folder containing your .gguf model files
MODELS_DIR=C:\llama.cpp\models
# Host/port llama-server should bind to.
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080
# Optional: exact filename (as it appears in MODELS_DIR) to load on backend
# startup. Leave blank to auto-load the first model found alphabetically.
LLAMA_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# OpenAI
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_IMAGE_MODEL=gpt-image-1

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---------------------------------------------------------------------------
# Google Gemini
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com

# ---------------------------------------------------------------------------
# Groq (OpenAI-compatible)
# ---------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------------------------------------------------------------------------
# Arbitrary OpenAI-compatible endpoints (vLLM, self-hosted, third parties).
# JSON array; each entry becomes a provider with id "custom:<id>".
# Example:
# CUSTOM_OPENAI_COMPATIBLE_PROVIDERS=[{"id":"vllm","name":"My vLLM box","base_url":"http://localhost:8000/v1","api_key":"","model":"llama-3-70b"}]
# ---------------------------------------------------------------------------
CUSTOM_OPENAI_COMPATIBLE_PROVIDERS=[]

# ---------------------------------------------------------------------------
# Web search -- set SEARCH_PROVIDER to brave | tavily | searxng
# ---------------------------------------------------------------------------
SEARCH_PROVIDER=
BRAVE_API_KEY=
TAVILY_API_KEY=
SEARXNG_URL=
SEARCH_MAX_RESULTS=5

# ---------------------------------------------------------------------------
# Image generation -- set IMAGE_PROVIDER to openai
# ---------------------------------------------------------------------------
IMAGE_PROVIDER=

# ---------------------------------------------------------------------------
# Documents / RAG
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=26214400
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200
RAG_TOP_K=5

# ---------------------------------------------------------------------------
# HTTP behaviour for cloud provider calls
# ---------------------------------------------------------------------------
PROVIDER_CONNECT_TIMEOUT=10
PROVIDER_REQUEST_TIMEOUT=120
PROVIDER_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# Rate limiting -- in-memory, per client IP. Protects against a runaway
# client loop or a compromised browser burning through provider API
# budget. Resets on backend restart.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_MINUTE=10

# ---------------------------------------------------------------------------
# Logging -- LOG_FORMAT=json for machine-parseable one-line-per-log-entry
# output (useful if you ship logs somewhere); default "text" is easier to
# read directly in chatui-backend-output.log.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Access control -- set this before sharing this instance with anyone else.
# Every request must then include "Authorization: Bearer <ACCESS_TOKEN>".
# Leave blank for frictionless solo use on your own machine.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ---------------------------------------------------------------------------
ACCESS_TOKEN=
