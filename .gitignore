# ==========================================
# ChatUI - Repository-wide Git Ignore Rules
# ==========================================

# ------------------------------------------
# Environment files and secrets
# ------------------------------------------
.env
.env.*
!.env.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx
*.crt

# ------------------------------------------
# Runtime artifacts
# ------------------------------------------
.chatui-backend.pid
.chatui-frontend.pid

chatui-start.log
chatui-backend-output.log
chatui-backend-error.log
chatui-frontend-output.log
chatui-frontend-error.log

*.log
*.pid

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*.so

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ------------------------------------------
# Node.js
# ------------------------------------------
node_modules/
dist/
build/
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------
# Application runtime data
# ------------------------------------------
chatui-backend/data/

# ------------------------------------------
# Operating system files
# ------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# ------------------------------------------
# IDE and editor settings
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo